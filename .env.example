POSTGRES_DB=news_tool
POSTGRES_USER=news_tool
POSTGRES_PASSWORD=change-this-local-password
WEB_PORT=8000
TZ=Asia/Ho_Chi_Minh
POLL_SECONDS=3
JOB_TIMEOUT_SECONDS=120
MAX_ATTEMPTS=3
RETRY_DELAY_SECONDS=30
REQUEST_TIMEOUT_SECONDS=20
MAX_RESPONSE_BYTES=5242880
MAX_ARTICLES_PER_JOB=150
# Optional topics: comma-separated keywords, used for ranking relevance.
RANK_KEYWORDS=công nghệ,kinh tế,khoa học
# Reject local/private feed addresses by default. Only enable for trusted local feeds.
ALLOW_PRIVATE_SOURCES=false
# Script generation is explicit only; keys never appear in the browser.
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_PROVIDER=gemini
LLM_MAX_CONCURRENCY=2
LLM_FETCH_ARTICLE=true
ARTICLE_FETCH_TIMEOUT_SECONDS=3
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_MODEL=deepseek-flash
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=8192
# Testing only. Fake drafts can never pass the video handoff gate.
LLM_ALLOW_FAKE=false
# Local VieNeu-TTS v3 Turbo CPU service. Keep fp32 for the first benchmark;
# switch only after comparing pronunciation and audio integrity.
VIENEU_PRECISION=fp32
TTS_TIMEOUT_SECONDS=900
# TikTok Upload is opt-in. Put secrets only in .env.tiktok.
TIKTOK_ENABLED=false
TIKTOK_DIRECT_POST_ENABLED=false
TIKTOK_REDIRECT_URI=
TIKTOK_TIMEOUT_SECONDS=60

MAX_MEDIA_UPLOAD_MB=500
