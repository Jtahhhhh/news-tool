# Reference only: set these in Render Environment, not in local .env.
# Replace placeholders with values from the database's Render Connect menu.
APP_ENV=production
DEBUG=false

# Direct connection (default PostgreSQL port 5432):
DATABASE_URL=postgresql://<user>:<password>@<internal-host>:5432/<database>
DB_POOL_MODE=auto
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=15

# If managed PgBouncer is enabled, DATABASE_URL uses :6432 instead.
# Also set this DIRECT URL, because migrations use session-level advisory locks:
# MIGRATION_DATABASE_URL=postgresql://<user>:<password>@<internal-host>:5432/<database>

# External clients only: use the external hostname and sslmode=verify-full.
# Keep external URLs out of Render service configuration when internal access works.
