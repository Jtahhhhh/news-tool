# Reference only: set these in Render Environment, not in local .env.
# Replace placeholders with values from the database's Render Connect menu.
APP_ENV=production
DEBUG=false

# Direct connection matching the supplied Render Internal Database URL.
# Replace <password> in Render Environment; never commit the real password.
DATABASE_URL=postgresql://news_postgres_xll2_user:<password>@dpg-dauim5jncjis73fpmhp0-a:5432/news_postgres_xll2
DB_POOL_MODE=direct
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=15

# If managed PgBouncer is confirmed enabled, replace the two settings above:
# DATABASE_URL=postgresql://news_postgres_xll2_user:<password>@dpg-dauim5jncjis73fpmhp0-a:6432/news_postgres_xll2
# DB_POOL_MODE=pgbouncer
# Also set this DIRECT URL, because migrations use session-level advisory locks:
# MIGRATION_DATABASE_URL=postgresql://news_postgres_xll2_user:<password>@dpg-dauim5jncjis73fpmhp0-a:5432/news_postgres_xll2

# External clients only: use the external hostname and sslmode=verify-full.
# Keep external URLs out of Render service configuration when internal access works.
